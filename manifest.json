{
  "manifest_version": 3,
  "name": "Better Dashboard for GitHub",
  "version": "0.2.0",
  "description": "Группировка репозиториев в боковой панели, добавление GitHub Actions на главный экран.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
